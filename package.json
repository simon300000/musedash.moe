{
  "name": "musedash.moe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node server.js",
    "dev:ssr": "cross-env NODE_ENV=development node server.js",
    "dev:api": "node api",
    "build": "npm run build:api && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.ts --outDir dist/server",
    "build:api": "npx tsc -b",
    "test:search": "npm run build:api && node --test test/search-index.test.mjs",
    "test:worker": "npm run build:api && node --test api/worker.spec.js",
    "test:api": "npm run build:api && node --test test/search-index.test.mjs api/worker.spec.js",
    "api": "node api",
    "serve": "cross-env NODE_ENV=production node server.js",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@koa/router": "^15.3.1",
    "@vue/server-renderer": "^3.5.39",
    "bulma": "^1.0.4",
    "chart.js": "^4.2.0",
    "chartjs-adapter-moment": "^1.0.1",
    "js-cookie": "^3.0.7",
    "koa": "^3.1.2",
    "koa-body": "^4.2.0",
    "koa-mount": "^4.0.0",
    "koa-static": "^5.0.0",
    "lru-cache": "^6.0.0",
    "moment": "^2.29.4",
    "pinia": "^3.0.4",
    "rave-level": "^1.0.0",
    "undici": "^7.28.0",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
