    "@types/lru-cache": "^5.1.0",
    "@types/node": "^24.0.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "cross-env": "^10.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^7.18.0",
    "postcss-safe-parser": "^7.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.101.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-core": "^7.4.1",
